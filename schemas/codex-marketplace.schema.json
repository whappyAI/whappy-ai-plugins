{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/whappyAI/whappy-ai-plugins/schemas/codex-marketplace.schema.json",
  "title": "Codex repo marketplace (.agents/plugins/marketplace.json)",
  "description": "OpenAI publishes no JSON schema for this file. This schema follows https://developers.openai.com/plugins/build/plugins.md (Marketplace metadata) and the parser codex-rs/core-plugins/src/marketplace.rs (RawMarketplaceManifest, openai/codex@cf3ff1530d821ec2d26452da4971d8e3e7d18d25). The docs ask for policy.installation, policy.authentication and category on every entry, so they are required here.",
  "type": "object",
  "required": ["name", "interface", "plugins"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "interface": {
      "type": "object",
      "required": ["displayName"],
      "additionalProperties": false,
      "properties": { "displayName": { "type": "string", "minLength": 1 } }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source", "policy", "category"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "source": {
            "type": "object",
            "required": ["source", "path"],
            "additionalProperties": false,
            "properties": {
              "source": { "const": "local" },
              "path": { "type": "string", "pattern": "^\\./(?!.*(^|/)\\.\\.(/|$)).*$" }
            }
          },
          "policy": {
            "type": "object",
            "required": ["installation", "authentication"],
            "additionalProperties": false,
            "properties": {
              "installation": { "enum": ["AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"] },
              "authentication": { "enum": ["ON_INSTALL", "ON_USE"] }
            }
          },
          "category": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
